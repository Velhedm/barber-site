PORT=3000
APP_ORIGIN=http://localhost:3000
DB_PATH=./data/bookings.sqlite
# Run npm run admin:hash. Only the resulting hash goes here.
ADMIN_PASSWORD_HASH=
# Run npm run push:keys once. Keep this pair stable across deploys/restarts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Public deployment requires HTTPS, a persistent /data disk, one instance:
# NODE_ENV=production
# TRUST_PROXY=1
