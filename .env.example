PORT=3000
APP_ORIGIN=http://localhost:3000
# Neon PostgreSQL (keep this value secret). Empty = local SQLite.
DATABASE_URL=
DB_PATH=./data/bookings.sqlite
# Run npm run admin:hash. Only the resulting hash goes here.
ADMIN_PASSWORD_HASH=
# Alternative for Render Dashboard: your own password, at least 12 characters.
# Overrides ADMIN_PASSWORD_HASH. Do not send it in chat.
ADMIN_PASSWORD=
# Run npm run push:keys once. Keep this pair stable across deploys/restarts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Public deployment requires HTTPS, Neon DATABASE_URL or a persistent /data disk; one instance:
# NODE_ENV=production
# TRUST_PROXY=1
